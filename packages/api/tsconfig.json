{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Api Library",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "rootDir": "src",
    "paths": {
      "@colanode/api/*": ["./src/*"],
      "@colanode/core/*": ["../../packages/core/src/*"]
    }
  },
  "references": [
    {
      "path": "../core"
    }
  ]
}
